{
  "entities": {
    "medical_reports": {
      "title": "Medical Reports",
      "description": "Scanned PDF outsource medical reports and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "fileType": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "hospital": { "type": "string" },
        "customHospital": { "type": "string" },
        "reportDate": { "type": "string" },
        "uploadDate": { "type": "string" },
        "hasCDROM": { "type": "boolean" },
        "notes": { "type": "string" },
        "userId": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "storagePath": { "type": "string" }
      },
      "required": ["fileName", "fileSize", "category", "hospital", "userId"]
    },
    "patient_profiles": {
      "title": "Patient Profiles",
      "description": "Registered patients in the temporary medical record system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "idType": { "type": "string" },
        "idValue": { "type": "string" },
        "gender": { "type": "string" },
        "country": { "type": "string" },
        "currentZone": { "type": "string" },
        "bedNumber": { "type": "string" },
        "registeredAt": { "type": "string" },
        "userId": { "type": "string" },
        "createdByEmail": { "type": "string" }
      },
      "required": ["name", "idType", "idValue", "gender", "currentZone", "userId"]
    },
    "clerking_notes": {
      "title": "Clerking Notes",
      "description": "Clinical clerking progress notes for patients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "progressNote": { "type": "string" },
        "bedNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "status": { "type": "string" },
        "amendments": { "type": "array" }
      },
      "required": ["patientId", "progressNote", "createdBy", "status"]
    },
    "stock_items": {
      "title": "Stock Items",
      "description": "Inventory stock items tracked across devices in real time",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "currentStock": { "type": "number" },
        "unit": { "type": "string" },
        "pricePerUnit": { "type": "number" },
        "locationStored": { "type": "string" },
        "warningThreshold": { "type": "number" },
        "expiryDate": { "type": "string" },
        "batches": { "type": "array" },
        "notes": { "type": "string" },
        "pictureUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "currentStock", "unit", "warningThreshold"]
    },
    "stock_transactions": {
      "title": "Stock Transactions",
      "description": "Inventory movement and adjustment audit logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "action": { "type": "string" },
        "quantity": { "type": "number" },
        "stockBefore": { "type": "number" },
        "stockAfter": { "type": "number" },
        "destinationOrSource": { "type": "string" },
        "staffName": { "type": "string" },
        "notes": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "itemId", "itemName", "action", "quantity", "staffName", "timestamp"]
    }
  },
  "firestore": {
    "/patient_profiles/{patientId}": {
      "schema": "patient_profiles",
      "description": "Primary clinical patient profile database"
    },
    "/clerking_notes/{noteId}": {
      "schema": "clerking_notes",
      "description": "Clerking entries and progress notes for registered patients"
    },
    "/stock_items/{itemId}": {
      "schema": "stock_items",
      "description": "Shared real-time stock inventory items"
    },
    "/stock_transactions/{transactionId}": {
      "schema": "stock_transactions",
      "description": "Shared real-time stock movement audit logs"
    }
  }
}
