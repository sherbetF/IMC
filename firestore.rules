rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ogTzhERlbpPhRFsicEkdUCvma1S2';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Global admin override for all documents in database
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Medical Reports collection access for authenticated users
    match /medical_reports/{reportId} {
      allow read, write: if isAuthenticated();
    }
  }
}

